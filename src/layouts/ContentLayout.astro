---
import SecondaryNav from "~/components/SecondaryNav.astro";
import Layout, { type Props as LayoutProps } from "~/layouts/Layout.astro";

interface Props extends LayoutProps {
	navTitle?: string;
	navDescription?: string;
}

const { title, navTitle, description, navDescription, ...rest } = Astro.props;
---

<Layout
	title={`.${title} | Curstantine`}
	{description}
	{...rest}
>
	<SecondaryNav title={navTitle ?? title} description={navDescription ?? description} deco="content" />
	<slot />
</Layout>

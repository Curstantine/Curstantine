---
interface Props {
	title: string;
	description: string;
	deco: "tool" | "content";
}

const { title, description, deco } = Astro.props;
---

<nav class="flex flex-col gap-2 sm:flex-row py-3 sm:items-center justify-between container">
	<div class="flex flex-col justify-center">
		<h1 class="font-semibold font-mono">
			{deco === "content" && <span class="text-accent-1">.</span>}{title}{deco === "tool" && (
				<span class="text-accent-1">()</span>
			)}
		</h1>
		<span class="text-xs">{description}</span>
	</div>

	<div class="inline-flex font-mono text-sm gap-4">
		<a href="/">~/</a>
		<a href="/web_quirks">.web_quirks</a>
		<a href="/tools/favicon">to_favicon()</a>
	</div>
</nav>
